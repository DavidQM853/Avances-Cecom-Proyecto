{
  "info": {
    "_postman_id": "cecom-dashboard-api-v1-collection",
    "name": "Dashboard Presupuestos CECOM — API v1 (cecom_presupuestos_er)",
    "description": "Colección oficial Postman para el backend Dashboard Presupuestos CECOM (Laravel 13 + Sanctum + cecom_presupuestos_er).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000/api/v1" },
    { "key": "token", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cecom.gob.mx\",\n  \"password\": \"password\",\n  \"device_name\": \"Postman CECOM\"\n}"
            }
          }
        },
        {
          "name": "GET /auth/me",
          "request": { "method": "GET", "url": "{{base_url}}/auth/me" }
        },
        {
          "name": "POST /auth/logout",
          "request": { "method": "POST", "url": "{{base_url}}/auth/logout" }
        }
      ]
    },
    {
      "name": "2. Agregaciones Temporales (Diario a Anual)",
      "item": [
        {
          "name": "GET /agregaciones (Mensual)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/agregaciones?periodo=mensual&desde=2025-01-01&hasta=2025-12-31&departamento_id=2"
          }
        },
        {
          "name": "GET /agregaciones (Trimestral)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/agregaciones?periodo=trimestral&desde=2025-01-01&hasta=2025-12-31"
          }
        },
        {
          "name": "GET /agregaciones/tendencia",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/agregaciones/tendencia?meses=12&departamento_id=2"
          }
        },
        {
          "name": "GET /reportes/variabilidad-mensual",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/reportes/variabilidad-mensual?anio=2025&departamento_id=2"
          }
        }
      ]
    },
    {
      "name": "3. Presupuestos, Reservas y Gastos OPEX",
      "item": [
        {
          "name": "GET /presupuestos",
          "request": { "method": "GET", "url": "{{base_url}}/presupuestos?anio=2026" }
        },
        {
          "name": "GET /presupuestos-yoy/comparativa",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/presupuestos-yoy/comparativa?anio_base=2024&anio_comparar=2025"
          }
        },
        {
          "name": "POST /compromisos (Crear Reserva)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/compromisos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partida_id\": 1,\n  \"referencia_documento\": \"RES-2026-TI-001\",\n  \"monto_original\": 15000.00\n}"
            }
          }
        },
        {
          "name": "POST /gastos (Registrar Gasto Operativo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/gastos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partida_id\": 1,\n  \"monto\": 12500.00,\n  \"concepto\": \"Renovación Licencias Cloud\",\n  \"referencia_documento\": \"FAC-2026-9910\",\n  \"fecha_gasto\": \"2026-08-15\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Roles Dinámicos, Conciliación y Monitoreo",
      "item": [
        {
          "name": "GET /roles",
          "request": { "method": "GET", "url": "{{base_url}}/roles" }
        },
        {
          "name": "POST /roles/{rol}/asignar-usuario",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/roles/6/asignar-usuario",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"departamento_id\": 2,\n  \"restricciones_opex\": [\"OPEX-001\", \"OPEX-003\"],\n  \"motivo\": \"Control presupuestal sobre nómina y materiales\"\n}"
            }
          }
        },
        {
          "name": "GET /usuarios/{id}/permisos-efectivos",
          "request": { "method": "GET", "url": "{{base_url}}/usuarios/1/permisos-efectivos" }
        },
        {
          "name": "GET /reportes/conciliacion",
          "request": { "method": "GET", "url": "{{base_url}}/reportes/conciliacion" }
        },
        {
          "name": "GET /reportes/proyecciones",
          "request": { "method": "GET", "url": "{{base_url}}/reportes/proyecciones?anio_objetivo=2027" }
        },
        {
          "name": "GET /monitor/latencia",
          "request": { "method": "GET", "url": "{{base_url}}/monitor/latencia" }
        }
      ]
    }
  ]
}
